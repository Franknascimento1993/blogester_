---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Todos os posts do blog.">
  <header class="page-header">
    <p class="section-label">Arquivo</p>
    <h1>Blog</h1>
    <p class="intro">Todos os artigos publicados.</p>
  </header>

  {posts.length === 0 ? (
    <p class="empty">Nenhum post publicado ainda.</p>
  ) : (
    <div class="card-list">
      {posts.map((post) => (
        <article class="card">
          <a href={`/blog/${post.id}/`}>
            <h2 class="card-title">{post.data.title}</h2>
            <p class="card-desc">{post.data.description}</p>
            <div class="card-meta">
              <FormattedDate date={post.data.pubDate} />
              {post.data.tags.length > 0 && (
                <span class="meta-tags"> · {post.data.tags.join(' · ')}</span>
              )}
            </div>
          </a>
        </article>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-header h1 {
    margin: 0 0 0.5rem;
  }

  .intro {
    margin: 0;
    color: var(--color-muted);
    font-weight: 300;
  }

  .empty {
    color: var(--color-muted);
    font-weight: 300;
  }

  .card-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .meta-tags {
    opacity: 0.85;
  }
</style>
