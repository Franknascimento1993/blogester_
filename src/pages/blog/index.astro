---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Todos os posts do blog.">
  <h1>Blog</h1>
  <p class="intro">Lista de todos os artigos publicados.</p>

  {posts.length === 0 ? (
    <p class="empty">Nenhum post publicado ainda. Adicione arquivos em <code>src/content/blog/</code>.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>
            <h2>{post.data.title}</h2>
            <p class="desc">{post.data.description}</p>
            <div class="meta">
              <FormattedDate date={post.data.pubDate} />
              {post.data.tags.length > 0 && (
                <span class="tags"> · {post.data.tags.join(', ')}</span>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  h1 {
    margin-top: 0;
  }

  .intro {
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .empty {
    color: var(--color-muted);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    margin-bottom: 1.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-list a {
    color: inherit;
    text-decoration: none;
  }

  .post-list a:hover h2 {
    color: var(--color-accent);
  }

  .post-list h2 {
    margin: 0 0 0.35rem;
    font-size: 1.35rem;
  }

  .desc {
    margin: 0 0 0.35rem;
    color: var(--color-muted);
  }

  .meta {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .tags {
    opacity: 0.85;
  }
</style>
